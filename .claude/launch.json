{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "web-mocks",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "3001"],
      "env": { "EXPO_PUBLIC_USE_MOCKS": "true", "EXPO_PUBLIC_MODULES_SCOPE": "real" },
      "port": 3001
    }
  ]
}
