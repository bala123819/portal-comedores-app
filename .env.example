EXPO_PUBLIC_API_URL=https://cloud.mermab.com/api
EXPO_PUBLIC_USE_MOCKS=false
# Con mocks: "real" muestra sólo los módulos que el backend ofrece hoy; vacío = todo (prototipo)
EXPO_PUBLIC_MODULES_SCOPE=
# Forzar módulos puntuales si el Banco los habilita: mermas,familiasAlta,contactos,documentacion,programas,nutricionApi
EXPO_PUBLIC_ENABLE_MODULES=
# Número de WhatsApp del chatbot, formato internacional sin "+" (ej. 5491100000000)
EXPO_PUBLIC_WHATSAPP_NUMBER=
# Endpoint HTTP de los agentes (n8n / GoDubi). Vacío = agentes en modo simulado.
EXPO_PUBLIC_AGENTS_URL=
# Clave pública VAPID para Web Push (si el Banco la provee). Vacío = sin push web.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Solo para `npm run smoke`: NUNCA se incluyen en el bundle (no llevan prefijo EXPO_PUBLIC_)
CHECK_API_EMAIL=
CHECK_API_PASSWORD=
