EXPO_PUBLIC_API_URL=https://cloud.mermab.com/api
EXPO_PUBLIC_USE_MOCKS=false
# Con mocks: "real" muestra sólo los módulos que el backend ofrece hoy; vacío = todo (prototipo)
EXPO_PUBLIC_MODULES_SCOPE=
# Forzar módulos puntuales si el Banco los habilita: mermas,familiasAlta,contactos,documentacion,programas,nutricionApi
EXPO_PUBLIC_ENABLE_MODULES=
# Número de WhatsApp del chatbot, formato internacional sin "+" (ej. 5491100000000)
EXPO_PUBLIC_WHATSAPP_NUMBER=
# Endpoint HTTP de los agentes (n8n / GoDubi). Vacío = agentes en modo simulado.
EXPO_PUBLIC_AGENTS_URL=
# Clave pública VAPID para Web Push (si el Banco la provee). Vacío = sin push web.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Solo para `npm run smoke`: NUNCA se incluyen en el bundle (no llevan prefijo EXPO_PUBLIC_)
CHECK_API_EMAIL=
CHECK_API_PASSWORD=
# Chat con el asistente (GoDubi webchat, docs/asistente/). Datos públicos de la publicación, no son secretos.
# Modo: http (API real) | mock (simulado) | vacío = real en el celular y simulado en web (la API bloquea el navegador por CORS)
EXPO_PUBLIC_ASSISTANT_MODE=
EXPO_PUBLIC_ASSISTANT_BASE_URL=https://webchat.godubi.com/v1/webchat
EXPO_PUBLIC_ASSISTANT_PUBLICATION_ID=9806bc2a-7c76-4fe2-8d7a-79ae79544419
EXPO_PUBLIC_ASSISTANT_ORIGIN=https://app-organizaciones.mermab.com
# Organización que atiende hoy el asistente (para avisar si la app está logueada en otra)
EXPO_PUBLIC_ASSISTANT_ORG_NAME=Comedor Prueba Tesis API
